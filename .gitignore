# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
supabase/.temp/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files / secrets
.env
.env*.local

# typescript
*.tsbuildinfo

# SQL / DB migrations (already applied on Supabase — not needed in app repo)
supabase/migrations/
**/*.sql

# Python backend local artifacts & training data (APK uses Supabase Edge ML)
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.db
backend/.env
backend/data/
backend/models/
backend/node_modules/
