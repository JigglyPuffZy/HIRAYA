{
  "name": "hiraya",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "eas build -p android --profile preview --non-interactive",
    "build:aab": "eas build -p android --profile production --non-interactive",
    "release:apk": "npm run typecheck && eas build -p android --profile preview --non-interactive",
    "typecheck": "tsc --noEmit",
    "backend:train": "cd backend && set PYTHONPATH=.&& .venv\\Scripts\\python.exe scripts\\train_model.py",
    "backend:start": "cd backend && set PYTHONPATH=.&& .venv\\Scripts\\uvicorn.exe app.main:app --host 0.0.0.0 --port 8000"
  },
  "private": true
}
