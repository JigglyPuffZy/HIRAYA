# Copy to .env and fill in values before building an APK.
# EXPO_PUBLIC_* values are baked into the app at build time.

# Required for login / register / cloud profile + history
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-key

# Optional ML prediction API (public HTTPS via Supabase Edge Functions)
EXPO_PUBLIC_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1
EXPO_PUBLIC_ALLOW_CLEARTEXT=false
# EXPO_PUBLIC_API_TIMEOUT_MS=30000

# Weather — Open-Meteo is the default (no key needed)
# EXPO_PUBLIC_WEATHER_PROVIDER=openmeteo
# EXPO_PUBLIC_WEATHERAPI_KEY=
# EXPO_PUBLIC_WEATHER_API_KEY=
